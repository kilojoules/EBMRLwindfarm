#!/bin/bash
#BSUB -q hpc
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=8GB]"
#BSUB -W 08:00
#BSUB -J referee
#BSUB -o /zhome/5c/f/180689/projects/ebmrl/logs/referee_%J.out
#BSUB -e /zhome/5c/f/180689/projects/ebmrl/logs/referee_%J.err
#BSUB -u /dev/null

# Referee fixes (M1, M6) — ported from LUMI (out of CPU) to gbar.
# (1) rejection v2 (probes BLENDED action) vs rejection_endpoint vs linear
#     vs argmin on MM direction sweep, sigma=0.7, n=10.
# (2) beta sensitivity: b0p5 + b2p0 MM actors vs zero-yaw.

set -uo pipefail
PROJECT=/zhome/5c/f/180689/projects/ebmrl
VENV=/zhome/5c/f/180689/projects/ebmrl_env
cd "$PROJECT"
mkdir -p logs results

export PATH="$VENV/bin:$PATH"

set -e

echo "=== 1: rejection v2 4-mode comparison, MM direction sweep ==="
python -u scripts/blend_modes_compare.py \
    --checkpoint runs/del_aware_b1p0/checkpoints/step_200000.pt \
    --bundle checkpoints/teodor_dlc12_torch.pt \
    --layout multi_modal --horizon 200 --n-episodes 10 --sigma 0.7 \
    --safe-yaw-grid="-25,-15,-7.5,0,7.5,15,25" \
    --modes "linear,rejection,rejection_endpoint,argmin" \
    --out-json results/blend_modes_rejv2_mm.json

echo "=== 2a: beta=0.5 MM actor vs zero-yaw ==="
python -u scripts/eval_pi_perf_vs_safe.py \
    --checkpoint runs/del_aware_b0p5/checkpoints/step_200000.pt \
    --bundle checkpoints/teodor_dlc12_torch.pt \
    --layout multi_modal --horizon 200 --n-episodes 10 \
    --safe-yaw-deg "0,0,0" \
    --out-json results/beta_sens_b0p5_mm.json

echo "=== 2b: beta=2.0 MM actor vs zero-yaw ==="
python -u scripts/eval_pi_perf_vs_safe.py \
    --checkpoint runs/del_aware_b2p0/checkpoints/step_200000.pt \
    --bundle checkpoints/teodor_dlc12_torch.pt \
    --layout multi_modal --horizon 200 --n-episodes 10 \
    --safe-yaw-deg "0,0,0" \
    --out-json results/beta_sens_b2p0_mm.json
